# Petal backend local environment
# Copy to .env or export these variables in your shell before running the backend.
# Do not commit real secrets.

DB_URL=jdbc:postgresql://localhost:5432/petal_db?sslmode=disable
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=change-me-local-dev-only-change-before-shared-use

# Supabase Postgres example:
# Use direct or Session Pooler for the Spring Boot backend. Include sslmode=require.
# DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<supabase-db-password>

# Storage provider: local or supabase
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Required only when STORAGE_PROVIDER=supabase.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SUPABASE_FLORIST_LOGOS_BUCKET=florist-logos
SUPABASE_ORDER_PHOTOS_BUCKET=order-photos
SUPABASE_SIGNED_URL_EXPIRES_SECONDS=300
